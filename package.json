{
  "name": "fastify-service-template",
  "version": "0.1.0",
  "private": true,
  "description": "Layered Fastify/TypeScript service template.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ENVIRONMENT=local tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fastify/postgres": "^6.1.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
