aws_region              = "us-east-1"
environment             = "sandbox"
github_repository       = "kmasouri/fastify-service-template"
service_container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/fastify-svc-sandbox-service:latest"

service_environment_variables = {
  ENVIRONMENT = "production"
  HOST        = "0.0.0.0"
  PORT        = "3000"
}
